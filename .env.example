TS_AUTHKEY=tskey-auth-example
TS_HOSTNAME=deepseek-harness
SSH_AUTHORIZED_KEYS=ssh-ed25519 AAAA... you@example

# Optional override. Normally auto-discovered from the Tailscale sidecar.
DSH_TRUSTED_HOST=

DSH_VERSION=0.1.1-rc.2
PNPM_VERSION=11.7.0
DSH_TOOLS_MODE=both
DSH_PERMISSION_MODE=workspace-write
DSH_TELEMETRY_DISABLED=1

DEEPSEEK_API_KEY=
# Override only for an OpenAI-compatible DeepSeek proxy.
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
