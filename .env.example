TS_AUTHKEY=tskey-auth-example
TS_HOSTNAME=deepseek-harness
SSH_AUTHORIZED_KEYS=ssh-ed25519 AAAA... you@example

# Optional override. Normally auto-discovered from the Tailscale sidecar.
DSH_TRUSTED_HOST=

DSH_VERSION=0.2.1-rc.5
PNPM_VERSION=11.7.0

# dsh-superagent-prototype pin. 0.2.1-rc.5 is the npm "latest" dist-tag and
# satisfies the prototype's engines.dsh range. Bump the ref to move the bundle.
DSH_SUPERAGENT_REPOSITORY=https://github.com/deepseek-ai/dsh-superagent-prototype.git
DSH_SUPERAGENT_REF=6337fc823ce20251c8de8085948165c81aaa701e
DSH_SUPERAGENT_AUTO_UPDATE=0
DSH_SUPERAGENT_PORT=3082
DSH_SUPERAGENT_HTTPS_PORT=8443
# native (default) or ptc. The 0.1 "both" value is no longer valid.
DSH_TOOLS_MODE=native
DSH_PERMISSION_MODE=workspace-write
DSH_TELEMETRY_DISABLED=1

DEEPSEEK_API_KEY=
# Override only for an OpenAI-compatible DeepSeek proxy.
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
